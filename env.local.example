# AWS Configuration
AWS_REGION=us-east-1
AWS_PROFILE=default

# Deployment Configuration
STAGE=dev

# AWS Polly Configuration
VOICE_ID=Lea
LANGUAGE_CODE=fr-FR
POLLY_ENGINE=standard
TEXT_TYPE=ssml

# AWS Services Configuration
S3_BUCKET_NAME=sample-bucket
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:PollyTaskCompletedTopic

# Lambda Configuration
TIMEOUT=120
TIMEOUT_BULK=900
MEMORY_SIZE=512
MEMORY_SIZE_BULK=1024

# Retry Configuration
MAX_RETRY_ATTEMPTS=3

# Serverless Framework Configuration (for CI/CD)
SERVERLESS_ACCESS_KEY=your_serverless_access_key_here

# Optional: Override AWS credentials (if not using AWS CLI profile)
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Optional: Custom S3 bucket configuration
# S3_BUCKET_NAME=my-custom-audio-bucket

# Optional: Custom Polly voice and language
# VOICE_ID=Matthew
# LANGUAGE_CODE=en-US
# POLLY_ENGINE=neural

# Optional: Performance tuning
# TIMEOUT=300
# MEMORY_SIZE=1024
# MAX_RETRY_ATTEMPTS=5

# Optional: Different text type
# TEXT_TYPE=text
