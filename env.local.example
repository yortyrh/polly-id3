# Local Development Environment Variables
# Copy this file to .env.local and customize for your local development
# This file contains configurations that should stay local and not be committed to version control

# AWS Configuration
AWS_REGION=us-east-1
AWS_PROFILE=default

# Development Environment
NODE_ENV=development
STAGE=dev

# AWS Polly Configuration
VOICE_ID=Lea
LANGUAGE_CODE=fr-FR
OUTPUT_FORMAT=mp3
POLLY_ENGINE=generative
TEXT_TYPE=ssml
MAX_RETRY_ATTEMPTS=3

# AWS Services Configuration
S3_BUCKET_NAME=sample-bucket

# Application Settings
TIMEOUT=120
TIMEOUT_BULK=900
MEMORY_SIZE=512
MEMORY_SIZE_BULK=1024

# Local Development Settings
LOG_LEVEL=debug
ENABLE_DEBUG_LOGGING=true

# Configuration Examples:
# 
# For English voice:
# VOICE_ID=Joanna
# LANGUAGE_CODE=en-US
# TEXT_TYPE=text
#
# For high-performance:
# TIMEOUT=900
# MEMORY_SIZE=1024
# MAX_RETRY_ATTEMPTS=5
#
# For production-like settings:
# S3_BUCKET_NAME=sample-bucket-prod
# TIMEOUT=300
# MEMORY_SIZE=1024
