# Local Development Environment Variables
# Copy this file to .env.local and customize for your local development
# This file contains configurations that should stay local and not be committed to version control

# AWS Configuration
AWS_REGION=us-east-1
AWS_PROFILE=default

# Development Environment
NODE_ENV=development
STAGE=dev

# AWS Polly Configuration
VOICE_ID=Lea
LANGUAGE_CODE=fr-FR
OUTPUT_FORMAT=mp3
POLLY_ENGINE=generative
TEXT_TYPE=ssml
MAX_RETRY_ATTEMPTS=3

# AWS Services Configuration
S3_BUCKET_NAME=sample-bucket

# Local Development Settings
LOG_LEVEL=debug
ENABLE_DEBUG_LOGGING=true
